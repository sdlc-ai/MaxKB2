# 基于已有的 zqv2:latest 镜像,只更新代码
# 阶段1: 编译前端
FROM node:24-alpine AS web-build
COPY ui ui
RUN cd ui && ls -la && if [ -d "dist" ]; then exit 0; fi && \
    npm install --prefer-offline --no-audit && \
    npm install -D concurrently && \
    NODE_OPTIONS="--max-old-space-size=10240" npx concurrently "npm run build" "npm run build-chat" && \
    find . -maxdepth 1 ! -name '.' ! -name 'dist' ! -name 'public' -exec rm -rf {} +

# 阶段2: 更新后端代码
FROM zqv2:latest AS stage-build

# 删除旧代码和 tar 文件
RUN rm -rf /opt/porsche-app/apps /opt/porsche-app/ui && \
    find /opt/porsche-app -maxdepth 1 -name "*.tar" -type f -delete

# 复制最新代码
COPY --chmod=700 apps /opt/porsche-app/apps

# 阶段3: 运行阶段
FROM zqv2:latest

ARG DOCKER_IMAGE_TAG=dev \
    PORSCHEAI_SANDBOX_HOME=/opt/porsche-app/sandbox

ENV DOCKER_IMAGE_TAG=${DOCKER_IMAGE_TAG}

# 从构建阶段复制更新后的后端代码
COPY --from=stage-build /opt/porsche-app/apps /opt/porsche-app/apps

# 从前端构建阶段复制编译后的 dist
COPY --from=web-build --chmod=700 ui /opt/porsche-app/ui

WORKDIR /opt/porsche-app

# 设置环境变量
ENV PORSCHEAI_DB_HOST=127.0.0.1 \
    PORSCHEAI_DB_PORT=5432 \
    PORSCHEAI_DB_NAME=porsche \
    PORSCHEAI_DB_USER=root \
    PORSCHEAI_DB_PASSWORD=Password123@postgres \
    PORSCHEAI_REDIS_HOST=127.0.0.1 \
    PORSCHEAI_REDIS_PORT=6379 \
    PORSCHEAI_REDIS_DB=0 \
    PORSCHEAI_REDIS_PASSWORD=Password123@redis

# 暴露端口
EXPOSE 8080

# 启动命令
CMD ["/usr/bin/start-all.sh"]
