FROM node:24-alpine AS web-build
COPY ui ui
RUN cd ui && ls -la && if [ -d "dist" ]; then exit 0; fi && \
    npm install --prefer-offline --no-audit && \
    npm install -D concurrently && \
    NODE_OPTIONS="--max-old-space-size=10240" npx concurrently "npm run build" "npm run build-chat" && \
    find . -maxdepth 1 ! -name '.' ! -name 'dist' ! -name 'public' -exec rm -rf {} +

FROM porsche-base:python3.11-pg17.6 AS stage-build
WORKDIR /opt/porsche-app
# 先复制依赖文件,利用 Docker 缓存
COPY pyproject.toml uv.lock ./
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null || true; \
    sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null || true; \
    apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ gettext libexpat1-dev libffi-dev && \
    apt-get clean all  && \
    rm -rf /var/lib/apt/lists/*
# 安装依赖(这层会被缓存,除非 pyproject.toml 或 uv.lock 改变)
# 尝试使用基础镜像中可能已有的 uv,或使用系统 pip 安装
RUN which uv || pip install --timeout 600 --trusted-host mirrors.aliyun.com --index-url http://mirrors.aliyun.com/pypi/simple/ uv --break-system-packages && \
    UV_HTTP_TIMEOUT=600 python -m uv pip install --trusted-host mirrors.aliyun.com --index-url http://mirrors.aliyun.com/pypi/simple/ -r pyproject.toml
# 再复制源代码
COPY --chmod=700 . /opt/porsche-app
RUN gcc -shared -fPIC -o ${PORSCHEAI_SANDBOX_HOME}/lib/sandbox.so /opt/porsche-app/installer/sandbox.c -ldl && \
    rm -rf /opt/porsche-app/ui && \
    find /opt/porsche-app  -depth \( -name ".git*" -o -name ".docker*" -o -name ".idea*" -o -name ".editorconfig*" -o -name ".prettierrc*" -o -name "README.md" -o -name "poetry.lock" -o -name "pyproject.toml"  \) -exec rm -rf {} + && \
    python /opt/porsche-app/apps/manage.py compilemessages && \
    export PIP_TARGET=/opt/porsche-app/sandbox/python-packages && \
    python -m uv pip install --index-url https://mirrors.aliyun.com/pypi/simple/ --target=$PIP_TARGET requests pymysql psycopg2-binary && \
    rm -rf /opt/porsche-app/installer
COPY --from=web-build --chmod=700 ui /opt/porsche-app/ui

FROM porsche-base:python3.11-pg17.6
ARG DOCKER_IMAGE_TAG=dev \
    BUILD_AT \
    GITHUB_COMMIT

ENV PORSCHEAI_VERSION="${DOCKER_IMAGE_TAG} (build at ${BUILD_AT}, commit: ${GITHUB_COMMIT})" \
    PORSCHEAI_DB_NAME=porsche \
    PORSCHEAI_DB_HOST=127.0.0.1 \
    PORSCHEAI_DB_PORT=5432  \
    PORSCHEAI_DB_USER=${POSTGRES_USER} \
    PORSCHEAI_DB_PASSWORD=${POSTGRES_PASSWORD} \
    PORSCHEAI_DB_MAX_OVERFLOW=80 \
    PORSCHEAI_REDIS_HOST=127.0.0.1 \
    PORSCHEAI_REDIS_PORT=6379 \
    PORSCHEAI_REDIS_DB=0 \
    PORSCHEAI_REDIS_PASSWORD=${REDIS_PASSWORD} \
    PORSCHEAI_EMBEDDING_MODEL_PATH=/opt/porsche-app/model/embedding \
    PORSCHEAI_EMBEDDING_MODEL_NAME=/opt/porsche-app/model/embedding/shibing624_text2vec-base-chinese \
    PORSCHEAI_LOCAL_MODEL_HOST=127.0.0.1 \
    PORSCHEAI_LOCAL_MODEL_PORT=11636 \
    PORSCHEAI_LOCAL_MODEL_PROTOCOL=http \
    PIP_TARGET=/opt/porsche/python-packages

WORKDIR /opt/porsche-app
COPY --from=stage-build /opt/porsche-app /opt/porsche-app
COPY --from=stage-build /opt/py3 /opt/py3

EXPOSE 8080
VOLUME /opt/porsche
ENTRYPOINT ["bash", "-c"]
CMD [ "/usr/bin/start-all.sh" ]